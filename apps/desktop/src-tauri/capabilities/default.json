{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities of the Personal Analyst windows: core events and windowing plus the native dialog plugin. Everything else goes through the app's own commands.",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:app:default",
    "dialog:default"
  ]
}
